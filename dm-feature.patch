+// ─── DM relay helpers ─────────────────────────────────────────────────────────
+function dmEmbed(fromLabel, text, color, attachments = []) {
+  const embed = new EmbedBuilder()
+    .setAuthor({ name: fromLabel })
+    .setDescription(text || "*No text*")
+    .setColor(color)
+    .setTimestamp();
+  if (attachments.length) embed.addFields({ name: "Attachments", value: attachments.join("\n").slice(0, 1024) });
+  return embed;
+}
+
+async function openDmSession(guild, targetMember, staffUser) {
+  const user = targetMember.user;
+  const permissionOverwrites = [
+    { id: guild.roles.everyone, deny: [PermissionFlagsBits.ViewChannel] },
+    { id: STAFF_ROLE_1, allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.ReadMessageHistory] },
+    { id: STAFF_ROLE_2, allow: [PermissionFlagsBits.ViewChannel, PermissionFlagsBits.SendMessages, PermissionFlagsBits.ReadMessageHistory] },
+  ];
+  const channelOptions = {
+    name: `dm-${user.username}`,
+    type: ChannelType.GuildText,
+    permissionOverwrites,
+    topic: `DM session with ${user.tag} (${user.id}) | Started by ${staffUser.tag}`,
+  };
+  if (DM_CATEGORY_ID) channelOptions.parent = DM_CATEGORY_ID;
+  const channel = await guild.channels.create(channelOptions);
+
+  const session = {
+    channelId: channel.id, guildId: guild.id, userTag: user.tag,
+    startedBy: staffUser.tag, startedAt: new Date().toISOString(), log: [],
+  };
+  dmSessions.set(user.id, session);
+  saveDmSessions();
+
+  const until = targetMember.communicationDisabledUntil;
+  await channel.send({
+    embeds: [new EmbedBuilder()
+      .setTitle("DM Session Opened")
+      .setColor(0xfee75c)
+      .addFields(
+        { name: "Member",      value: `<@${user.id}> (${user.tag})`, inline: true },
+        { name: "Started By",  value: staffUser.tag, inline: true },
+        { name: "Timed Out Until", value: until ? `<t:${Math.floor(until.getTime() / 1000)}:F>` : "Not timed out", inline: true },
+      )
+      .setDescription(
+        "Anything staff type in this channel is sent to the member by DM, and their DM replies appear here.\n" +
+        "Messages starting with `?` are **not** sent, so you can use them for internal notes.\n" +
+        "Use `?dmclose <reason>` to end the conversation."
+      )
+      .setTimestamp()],
+  });
+  return { channel, session };
+}
+
+// Sends a staff message to the member. Returns true if delivered.
+async function relayStaffToUser(userId, session, staffUser, text, attachments = []) {
+  try {
+    const user = await client.users.fetch(userId);
+    await user.send({ embeds: [dmEmbed("NWIPBX Staff", text, 0x5865f2, attachments)] });
+    logDm(session, staffUser.tag, "staff -> member", text, attachments);
+    return true;
+  } catch (err) {
+    console.warn("Could not DM member:", err.message);
+    return false;
+  }
+}
+
+async function closeDmSession(userId, session, closedByTag, reason) {
+  dmSessions.delete(userId);
+  saveDmSessions();
+
+  try {
+    const user = await client.users.fetch(userId);
+    await user.send({ embeds: [new EmbedBuilder()
+      .setTitle("Conversation Closed")
+      .setDescription(`This conversation with NWIPBX staff has been closed.\n\n**Reason:** ${reason}`)
+      .setColor(0xed4245)
+      .setTimestamp()] });
+  } catch {}
+
+  const lines = [
+    "NWIPBX - DM SESSION TRANSCRIPT",
+    "==============================",
+    "",
+    `Member     : ${session.userTag} (${userId})`,
+    `Started by : ${session.startedBy}`,
+    `Started at : ${new Date(session.startedAt).toLocaleString()}`,
+    `Closed by  : ${closedByTag}`,
+    `Reason     : ${reason}`,
+    "",
+    "---",
+    "",
+  ];
+  for (const entry of session.log) {
+    lines.push(`[${new Date(entry.at).toLocaleString()}] ${entry.authorTag} (${entry.direction})`);
+    lines.push(`  ${entry.text || "[No text]"}`);
+    if (entry.attachments?.length) lines.push(`  Attachments: ${entry.attachments.join(", ")}`);
+    lines.push("");
+  }
+  lines.push("---", "End of transcript");
+
+  try {
+    const transcriptChannel = await client.channels.fetch(TRANSCRIPT_CHANNEL);
+    await transcriptChannel.send({ embeds: [new EmbedBuilder()
+      .setTitle("Transcript - DM Session")
+      .setColor(0xfee75c)
+      .addFields(
+        { name: "Member",    value: `<@${userId}>`, inline: true },
+        { name: "Closed By", value: closedByTag, inline: true },
+        { name: "Reason",    value: reason },
+      )
+      .setTimestamp()] });
+    let current = "";
+    for (const line of lines) {
+      if ((current + line + "\n").length > 1850) { await transcriptChannel.send("```\n" + current + "```"); current = ""; }
+      current += line + "\n";
+    }
+    if (current) await transcriptChannel.send("```\n" + current + "```");
+  } catch (err) { await reportError(err, "closeDmSession > transcript"); }
+
+  try {
+    const channel = await client.channels.fetch(session.channelId);
+    await channel.send({ embeds: [new EmbedBuilder()
+      .setTitle("DM Session Closed")
+      .setColor(0xed4245)
+      .addFields({ name: "Closed By", value: closedByTag, inline: true }, { name: "Reason", value: reason, inline: true })
+      .setTimestamp()] });
+    setTimeout(() => channel.delete(`DM session closed by ${closedByTag}: ${reason}`).catch(err => reportError(err, "closeDmSession > delete")), 5000);
+  } catch {}
+}
